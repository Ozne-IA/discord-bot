# Copie ce fichier en ".env" (ou mets ces valeurs dans les « Variables » de Railway).
# Ne partage JAMAIS ces valeurs.

# Portail développeur → ton application → Bot → Reset Token
DISCORD_TOKEN=

# Portail développeur → ton application → OAuth2 → Client Secret (Reset Secret)
DISCORD_CLIENT_SECRET=

# Adresse publique du panel, SANS / à la fin (ex : https://panel.tondomaine.fr)
# Ajoute aussi  <PUBLIC_URL>/callback  dans OAuth2 → Redirects sur le portail.
PUBLIC_URL=

# Contact affiché sur les pages /terms et /privacy (e-mail OU lien d'invitation de ton serveur de support)
CONTACT=

# --- Premium ---
# ID du SKU d'abonnement : portail développeur → ton application → Monetization → SKUs.
# Vide = abonnements Discord désactivés ; tu peux quand même offrir Premium avec /premium_admin give.
PREMIUM_SKU_ID=

# --- Alertes Twitch (facultatif) : https://dev.twitch.tv/console → Register Your Application ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# 14.5 : modération Twitch. Secret (10 à 100 caractères) qui signe les messages que Twitch envoie au bot.
# Ajoute aussi <PUBLIC_URL>/twitch/callback dans les « OAuth Redirect URLs » de ton application Twitch.
TWITCH_EVENTSUB_SECRET=

# --- 💎 Assistant IA (facultatif) : https://platform.claude.com → API Keys ---
# Payé à l'usage par toi (le propriétaire du bot). Vide = assistant IA désactivé.
ANTHROPIC_API_KEY=
# Modèle utilisé (vide = claude-opus-5-5)
ANTHROPIC_MODEL=

# --- 14.4 : chaque serveur peut brancher SA propre IA (ChatGPT, Mistral, Gemini, Claude) ---
# Secret qui chiffre les clés des serveurs (au moins 16 caractères). À GARDER : s'il change ou se perd,
# les admins devront recoller leur clé. Vide = fonction désactivée.
AI_KEYS_SECRET=

# Port du serveur web (Railway le définit tout seul)
PORT=8080

# Optionnel : ID d'UN serveur de test pour voir les nouvelles commandes instantanément.
# Laisse vide en production (les commandes sont alors globales, sur tous les serveurs).
DEV_GUILD_ID=

# Optionnel : emplacement de la base (par défaut data/bot.db)
DATABASE_PATH=

# --- 14.2 : alertes, sauvegardes, essai Premium, top.gg (tout est facultatif) ---
# ID d'un salon privé pour les alertes et sauvegardes (vide = message privé au propriétaire du bot)
OWNER_ALERT_CHANNEL_ID=
# off = pas d'alertes en message privé (erreurs, démarrage, serveurs ajoutés/retirés)
OWNER_ALERTS=on
# Sauvegarde automatique chaque nuit (off pour la couper), heure UTC, nombre de copies gardées
BACKUP_AUTO=on
BACKUP_HOUR=4
BACKUP_KEEP=14
# Durée de l'essai Premium gratuit en jours (0 = pas d'essai)
PREMIUM_TRIAL_DAYS=7
# top.gg : token de l'API (nombre de serveurs) et secret du webhook des votes (récompense /vote)
TOPGG_TOKEN=
TOPGG_WEBHOOK_SECRET=

# Pour le tunnel Cloudflare (PC avec start.bat, ou VPS avec docker-compose) :
CLOUDFLARE_TUNNEL_TOKEN=
